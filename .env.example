# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_ID=your_admin_telegram_id
TELEGRAM_ADMIN_USERNAME=your_admin_telegram_username_here
BOT_USERNAME=your_bot_username_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bot

# Limits
DAILY_WITHDRAWAL_LIMIT=1000
MIN_WITHDRAWAL_AMOUNT=1
ITEMS_PER_PAGE=3

# TRON Blockchain
TRON_PRIVATE_KEY=your_master_private_key
TRON_API_URL=https://api.trongrid.io
TRON_EXPLORER_URL=https://tronscan.org

# Deposit to main wallet rate (e.g. 0.9 = 90%)
DEPOSIT_TO_MAIN_WALLET_RATE=0.9

# Withdrawal fee rate (e.g. 0.01 = 1%)
WITHDRAWAL_FEE_RATE=0.01

# Referral rate (e.g. 0.01 = 1%)
REFERRAL_RATE=0.01

# Worker Configuration (in minutes)
DEPOSIT_CHECK_INTERVAL=4
WITHDRAWAL_PROCESS_INTERVAL=5

# Security
ENCRYPTION_KEY=your_32_byte_encryption_key

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot_marketplace.log
ERROR_LOG_FILE=logs/errors.log

# Game Settings (centralized)
HOUSE_EDGE=0.02
MIN_BET_AMOUNT=1
MAX_BET_AMOUNT=1000

# APScheduler
AP_SCHEDULER_THREAD_POOL_SIZE=5

# -------- Deposits & Bonuses --------
# Required confirmations to mark a deposit as confirmed
DEPOSIT_CONFIRMATIONS_REQUIRED=19

# First deposit bonus configuration
FIRST_DEPOSIT_BONUS_RATE=0.10  # 10%
FIRST_DEPOSIT_BONUS_MIN=10      # minimum deposit to qualify
FIRST_DEPOSIT_BONUS_MAX=100     # bonus cap in TRX

# Admin monitoring thresholds
ADMIN_BIG_WIN_TRX=5000
ADMIN_HOT_WALLET_MIN_TRX=300
ADMIN_SPIKE_GAMES_PER_MIN=50

EMERGENCY_STOP=False